# Run bash scripts/setup_local_env.sh to generate a private development signing key.
HRMS_JWT_SECRET_BASE64=
HRMS_JWT_ISSUER=hrms-employee-service
HRMS_JWT_AUDIENCE=hrms-leave-service
HRMS_RECRUITMENT_JWT_AUDIENCE=hrms-recruitment-service
HRMS_PAYROLL_JWT_AUDIENCE=hrms-payroll-service
# For production RS256/JWKS, configure this URL instead of sharing an HMAC key.
HRMS_JWT_JWK_SET_URI=
SPRING_PROFILES_ACTIVE=dev
EMPLOYEE_SERVICE_URL=http://localhost:8080
EMPLOYEE_SERVICE_PORT=8080
EMPLOYEE_MONGODB_URI=mongodb://localhost:27017/hrms_employee
# Optional import of existing local H2 accounts; the local launcher backs up the file first.
EMPLOYEE_IMPORT_LEGACY_H2=false
DEMO_LEAVE_EMAIL=leave@alder.example
EMPLOYEE_DIRECTORY_PATH=/api/internal/employees
EMPLOYEE_CONNECT_TIMEOUT_MS=1000
EMPLOYEE_READ_TIMEOUT_MS=2000
EMPLOYEE_MAX_ATTEMPTS=2
LEAVE_SERVICE_PORT=8081
# Comma-separated ISO dates configured by the company; no regional calendar is assumed.
LEAVE_HOLIDAYS=

# Restricted Employee Service credential for scheduled manager lookup (never a user's login token).
EMPLOYEE_SERVICE_INTERNAL_TOKEN=
LEAVE_REMINDERS_ENABLED=true

# Optional one-time first admin creation in the final Employee module. Supply your own credentials.
HRMS_BOOTSTRAP_ADMIN_ENABLED=false
HRMS_ADMIN_EMAIL=
HRMS_ADMIN_PASSWORD=

RECRUITMENT_SERVICE_PORT=8084
RECRUITMENT_BASE_URL=http://localhost:8084
RECRUITMENT_MONGODB_URI=mongodb://localhost:27017/hrms_recruitment
RECRUITMENT_STORAGE_ROOT=./resume-storage
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RECRUITMENT_KAFKA_TOPIC=hrms.application.events
RECRUITMENT_KAFKA_GROUP=hrms-notification-group

PAYROLL_SERVICE_PORT=8083
PAYROLL_MONGODB_URI=mongodb://localhost:27017/hrms_payroll
LEAVE_SERVICE_URL=http://localhost:8081
