    {
      "name": "4. Consistent hashing (run AFTER ~10 applications)",
      "description": "Also check the resume-storage/ folder on disk: files must physically move between node-X folders.",
      "item": [
        {
          "name": "4.1 List nodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/storage/nodes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storage",
                "nodes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"starts with node-A/B/C, 100 virtual nodes each\", () => {",
                  "  pm.expect(r.nodes).to.have.members(['node-A','node-B','node-C']);",
                  "  pm.expect(r.virtualNodesPerNode).to.eql(100);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Simulate 10,000 keys (load balance)",
          "request": {
            "method": "GET",
            "header": [],
