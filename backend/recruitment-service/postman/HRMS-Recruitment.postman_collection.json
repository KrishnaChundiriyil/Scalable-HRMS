              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 + exactly one alice@example.com\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().filter(c => c.email === 'alice@example.com')).to.have.length(1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Applications + resume storage",
      "description": "Run 3.1 about 8-10 times (Collection Runner or Send repeatedly) so every storage node holds some resumes before folder 4.",
      "item": [
        {
          "name": "3.1 Apply (select postman/sample-resume.txt in 'resume')",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "jobId",
                  "value": "{{jobId}}",
                  "type": "text"
                },
                {
                  "key": "name",
                  "value": "Alice",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "alice@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "9999999999",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"status SUBMITTED, resume + node recorded\", () => {",
                  "  pm.expect(a.status).to.eql('SUBMITTED');",
                  "  pm.expect(a.resumeFileName).to.be.a('string');",
                  "  pm.expect(a.storageNode).to.match(/^node-/);",
                  "  pm.expect(a.jobId).to.eql(pm.collectionVariables.get('jobId'));",
                  "});",
                  "pm.collectionVariables.set('applicationId', a.id);",
                  "console.log(\"Stored on\", a.storageNode);"
                ]
              }
            }
          ]
        },
