{
  "info": {
    "name": "HRMS Recruitment Service (backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start Mongo/Redis/Kafka (docker compose up -d), run the app, then run folders 1 to 6 in order (Collection Runner). In request 3.1 pick postman/sample-resume.txt for the 'resume' field. Set staffEmail/staffPassword to your configured Employee-service Admin login, then run folder 0 first. Admin is required for storage administration; HR can run recruitment business requests."
  },
  "item": [
    {
      "name": "0. Log in through Employee service (HR/Admin)",
      "item": [
        {
          "name": "Shared staff login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{employeeBaseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"staffToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Jobs + URL Shortener (Redis INCR + base62)",
      "description": "",
      "item": [
        {
          "name": "1.1 Publish job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Java Backend Developer\",\n  \"company\": \"Acme Tech\",\n  \"location\": \"Chennai\",\n  \"description\": \"Spring Boot, Mongo, Redis\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"has id + shortCode + shortUrl\", () => {",
                  "  pm.expect(j.id).to.be.a('string');",
                  "  pm.expect(j.shortCode).to.be.a('string').and.have.length.of.at.least(3);",
                  "  pm.expect(j.shortUrl).to.include('/s/' + j.shortCode);",
                  "});",
                  "pm.test(\"clicks start at 0\", () => pm.expect(j.clicks).to.eql(0));",
                  "pm.collectionVariables.set('jobId', j.id);",
                  "pm.collectionVariables.set('shortCode', j.shortCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"contains the job I just published\", () =>",
                  "  pm.expect(pm.response.json().map(x => x.id)).to.include(pm.collectionVariables.get('jobId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Get job by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same id + title\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.id).to.eql(pm.collectionVariables.get('jobId'));",
                  "  pm.expect(j.title).to.eql('Java Backend Developer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Get unknown job -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "000000000000000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Short link redirect (302, redirects OFF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/{{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "s",
                "{{shortCode}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"302 Found\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Location points to the job\", () =>",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/api/jobs/' + pm.collectionVariables.get('jobId')));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "1.6 Hit short link again (click counter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/{{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "s",
                "{{shortCode}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"302 Found\", () => pm.response.to.have.status(302));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "1.7 Clicks increased to 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"clicks == 2 (Redis INCR per redirect)\", () => pm.expect(pm.response.json().clicks).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 Unknown short code -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/zzzzzz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "s",
                "zzzzzz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "1.9 Shorten any URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shorten",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shorten"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://meet.example.com/interview/123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"code + shortUrl + longUrl returned\", () => {",
                  "  pm.expect(j.code).to.be.a('string');",
                  "  pm.expect(j.shortUrl).to.include('/s/' + j.code);",
                  "  pm.expect(j.longUrl).to.eql('https://meet.example.com/interview/123');",
                  "});",
                  "pm.collectionVariables.set('code1', j.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.10 Shorten again -> different code (unique counter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shorten",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shorten"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://meet.example.com/interview/456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"code differs from previous\", () => pm.expect(pm.response.json().code).to.not.eql(pm.collectionVariables.get('code1')));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.11 Shorten invalid URL -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shorten",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shorten"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"ftp://bad\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error message\", () => pm.expect(pm.response.json().error).to.include('http'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Candidates",
