{
  "info": {
    "name": "Scalable HRMS - Leave Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Business API collection. Supply real Employee Service tokens and employeeId. No credentials are included. See docs/INTEGRATION_CONTRACTS.md and docs/LEAVE_POLICY.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "leaveId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "requestKey",
      "value": ""
    },
    {
      "key": "startDate",
      "value": ""
    },
    {
      "key": "endDate",
      "value": ""
    },
    {
      "key": "year",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"startDate\")) {",
          "  const start = new Date(); start.setDate(start.getDate()+7);",
          "  while (start.getDay() !== 1) start.setDate(start.getDate()+1);",
          "  const end = new Date(start); end.setDate(end.getDate()+1);",
          "  const iso = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,\"0\")}-${String(d.getDate()).padStart(2,\"0\")}`;",
          "  pm.collectionVariables.set(\"startDate\", iso(start));",
          "  pm.collectionVariables.set(\"endDate\", iso(end));",
          "  pm.collectionVariables.set(\"year\", String(start.getFullYear()));",
          "}",
          "if (!pm.collectionVariables.get(\"requestKey\")) pm.collectionVariables.set(\"requestKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Leave types and policy",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/types",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "My balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/me/balance?year={{year}}",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Apply for annual leave",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{requestKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/leaves",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"ANNUAL\",\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"reason\": \"Family appointment\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"leaveId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "My leave history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/me?year={{year}}",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Manager pending list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/pending?year={{year}}",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Manager approves",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/leaves/{{employeeId}}/{{leaveId}}/decision",
        "description": "Use the assigned manager or HR/Admin. For parental leave also supply eligibilityNote.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approve\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Notification history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/notifications?limit=50",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Older notification history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/notifications?before={{notificationId}}&limit=50",
        "description": "Set notificationId to the last item in the previous newest-first page.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Missed notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/notifications?after={{notificationId}}&limit=50",
        "description": "After returns ascending order. Also refresh recent history after reconnect/outbox recovery and deduplicate IDs.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Live notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/notifications/stream",
        "description": "Keep the request open while a manager decides leave. A streaming client must support Authorization headers.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Employee cancels before start",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/leaves/me/{{leaveId}}/cancel",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Travel plans have changed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Manager rejects another pending request",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/leaves/{{employeeId}}/{{leaveId}}/decision",
        "description": "Create another request and use its ID. Already approved/cancelled/rejected requests cannot be decided again.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approve\": false,\n  \"rejectionReason\": \"Team coverage unavailable\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Employee profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/me/employee-profile",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Scoped employee history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/employees/{{employeeId}}?year={{year}}",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Approved leave overlapping date range",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/leaves/employees/{{employeeId}}/approved?from={{startDate}}&to={{endDate}}",
        "description": "Returns full approved requests intersecting the range; days is for the full request, not clipped to the range.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Apply for maternity leave",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/leaves",
        "description": "Change dates and request ID as appropriate; conflicting pending/approved dates are refused.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employeeToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"MATERNITY\",\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"reason\": \"Parental leave request\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"leaveId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Approve parental leave with eligibility review",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/leaves/{{employeeId}}/{{leaveId}}/decision",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approve\": true,\n  \"eligibilityNote\": \"HR reviewed the applicable entitlement and eligibility\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
